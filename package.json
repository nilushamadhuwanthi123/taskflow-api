{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow API - a JWT-authenticated task management REST API built as a DevOps/CI-CD portfolio showcase (Docker + GitHub Actions + Render).",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "lint": "eslint ."
  },
  "keywords": [
    "task-manager",
    "rest-api",
    "express",
    "mongodb",
    "devops",
    "ci-cd",
    "docker"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
