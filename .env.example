# Port the HTTP server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string
# Local dev with docker-compose: mongodb://mongo:27017/taskflow
# Local dev without Docker:      mongodb://127.0.0.1:27017/taskflow
# Production (e.g. MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster-url>/taskflow
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
# JWT expiry (e.g. 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins (use * for any origin)
CORS_ORIGIN=*
